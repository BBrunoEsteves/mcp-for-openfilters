{
  "manifest_version": "0.4",
  "name": "openfilters-mcp",
  "display_name": "OpenFilters",
  "version": "0.1.2",
  "description": "Design, simulate and optimize optical thin-film coatings with the OpenFilters engine.",
  "long_description": "Thin-film optical coating design with the calculation engine of OpenFilters (S. Larouche and L. Martinu, Polytechnique Montréal): spectra, color, electric field, monitoring curves, refinement/needle/step optimization, campaigns and Monte Carlo yield, with .ofp projects that open in the OpenFilters GUI. Unofficial: not affiliated with or endorsed by the OpenFilters authors.",
  "author": {
    "name": "Bruno Esteves"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BBrunoEsteves/openfilters-mcp"
  },
  "homepage": "https://github.com/BBrunoEsteves/openfilters-mcp",
  "documentation": "https://github.com/BBrunoEsteves/openfilters-mcp#readme",
  "support": "https://github.com/BBrunoEsteves/openfilters-mcp/issues",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "thin film",
    "optical coating",
    "optics",
    "interference filter",
    "OpenFilters"
  ],
  "privacy_policies": [
    "https://github.com/BBrunoEsteves/openfilters-mcp/blob/main/PRIVACY.md"
  ],
  "server": {
    "type": "uv",
    "entry_point": "src/server.py"
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  },
  "tools": [
    {
      "name": "server_info",
      "description": "Server information"
    },
    {
      "name": "list_materials",
      "description": "List materials"
    },
    {
      "name": "get_material_index",
      "description": "Material optical constants"
    },
    {
      "name": "add_material",
      "description": "Add a material"
    },
    {
      "name": "describe_design",
      "description": "Describe a design"
    },
    {
      "name": "compute_spectrum",
      "description": "Compute spectrum"
    },
    {
      "name": "compute_angle_scan",
      "description": "Angle scan"
    },
    {
      "name": "compute_color",
      "description": "Coating color"
    },
    {
      "name": "compute_electric_field",
      "description": "Electric field in the coating"
    },
    {
      "name": "compute_monitoring_curves",
      "description": "Optical monitoring curves"
    },
    {
      "name": "evaluate_design",
      "description": "Evaluate a design"
    },
    {
      "name": "layer_sensitivity",
      "description": "Layer sensitivity"
    },
    {
      "name": "optimize_design",
      "description": "Optimize a design"
    },
    {
      "name": "run_batch",
      "description": "Run a parameter sweep"
    },
    {
      "name": "run_optimization_campaign",
      "description": "Run an optimization campaign"
    },
    {
      "name": "tolerance_analysis",
      "description": "Tolerance (yield) analysis"
    },
    {
      "name": "job_status",
      "description": "Job status"
    },
    {
      "name": "list_jobs",
      "description": "List jobs"
    },
    {
      "name": "get_results",
      "description": "Get job results"
    },
    {
      "name": "cancel_job",
      "description": "Cancel a job"
    },
    {
      "name": "load_project",
      "description": "Load an OpenFilters project"
    },
    {
      "name": "save_project",
      "description": "Save an OpenFilters project"
    }
  ],
  "tools_generated": false
}
