{
  "manifest_version": "0.4",
  "name": "mcp-for-openfilters",
  "display_name": "MCP for OpenFilters",
  "version": "0.2.1",
  "description": "Design, simulate and optimize optical thin-film coatings with the OpenFilters engine.",
  "long_description": "Thin-film optical coating design with the calculation engine of OpenFilters (S. Larouche and L. Martinu, Polytechnique Montréal): spectra, color, electric field, monitoring curves, refinement/needle/step optimization, campaigns and Monte Carlo yield, with .ofp projects that open in the OpenFilters GUI. Unofficial: not affiliated with or endorsed by the OpenFilters authors. Developed and tested with Claude (Claude Desktop and Claude Code); other MCP clients are untested.",
  "author": {
    "name": "Bruno Esteves",
    "email": "mcp.for.openfilters@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BBrunoEsteves/mcp-for-openfilters"
  },
  "homepage": "https://github.com/BBrunoEsteves/mcp-for-openfilters",
  "documentation": "https://github.com/BBrunoEsteves/mcp-for-openfilters#readme",
  "support": "https://github.com/BBrunoEsteves/mcp-for-openfilters/issues",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "thin film",
    "optical coating",
    "optics",
    "interference filter",
    "OpenFilters"
  ],
  "privacy_policies": [
    "https://github.com/BBrunoEsteves/mcp-for-openfilters/blob/main/PRIVACY.md"
  ],
  "server": {
    "type": "uv",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "src/server.py"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  },
  "tools": [
    {
      "name": "server_info",
      "description": "Server information"
    },
    {
      "name": "list_materials",
      "description": "List materials"
    },
    {
      "name": "get_material_index",
      "description": "Material optical constants"
    },
    {
      "name": "add_material",
      "description": "Add a material"
    },
    {
      "name": "remove_material",
      "description": "Remove a material"
    },
    {
      "name": "search_refractiveindex",
      "description": "Search refractiveindex.info"
    },
    {
      "name": "import_refractiveindex_material",
      "description": "Import a refractiveindex.info material"
    },
    {
      "name": "describe_design",
      "description": "Describe a design"
    },
    {
      "name": "compute_spectrum",
      "description": "Compute spectrum"
    },
    {
      "name": "compute_angle_scan",
      "description": "Angle scan"
    },
    {
      "name": "compute_color",
      "description": "Coating color"
    },
    {
      "name": "compute_electric_field",
      "description": "Electric field in the coating"
    },
    {
      "name": "compute_monitoring_curves",
      "description": "Optical monitoring curves"
    },
    {
      "name": "thermal_sensitivity",
      "description": "Thermal sensitivity of a peak"
    },
    {
      "name": "thermal_sweep",
      "description": "Thermal tuning sweep"
    },
    {
      "name": "evaluate_design",
      "description": "Evaluate a design"
    },
    {
      "name": "layer_sensitivity",
      "description": "Layer sensitivity"
    },
    {
      "name": "optimize_design",
      "description": "Optimize a design"
    },
    {
      "name": "run_batch",
      "description": "Run a parameter sweep"
    },
    {
      "name": "run_optimization_campaign",
      "description": "Run an optimization campaign"
    },
    {
      "name": "tolerance_analysis",
      "description": "Tolerance (yield) analysis"
    },
    {
      "name": "simulate_random_errors",
      "description": "Simulate random errors"
    },
    {
      "name": "job_status",
      "description": "Job status"
    },
    {
      "name": "list_jobs",
      "description": "List jobs"
    },
    {
      "name": "get_results",
      "description": "Get job results"
    },
    {
      "name": "cancel_job",
      "description": "Cancel a job"
    },
    {
      "name": "load_project",
      "description": "Load an OpenFilters project"
    },
    {
      "name": "save_project",
      "description": "Save an OpenFilters project"
    }
  ],
  "tools_generated": false
}
